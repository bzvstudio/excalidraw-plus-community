NODE_ENV=development
PORT=3100

DATABASE_URL=postgres://postgres:postgres@localhost:5498/excalidraw_plus

# Origin the browser talks to. In dev that is Vite, which proxies the API's
# paths so the session cookie lives on one origin. Required and must be https
# in production.
PUBLIC_BASE_URL=http://localhost:5176

# Where the API finds the built web app to serve on its own origin. Unset in
# dev, where Vite serves it and proxies the API's paths.
# WEB_DIST_DIR=../web/dist

# Connections the API keeps open to Postgres. Lower it on a small database
# plan, whose connection limit is shared with everything else on it.
# DATABASE_POOL_MAX=20

# Signs session cookies and tokens. Deliberately blank: this file must never
# carry a usable secret, or a deployment that copies it inherits one everybody
# can read. Generate one with:
# openssl rand -base64 32
AUTH_SECRET=

# Encrypts scene content before it reaches the database: 32 random bytes,
# base64. Blank here for the same reason as AUTH_SECRET. Losing it loses every scene. To rotate, set the new key
# here and the old one as ENCRYPTION_KEY_PREVIOUS, run
# pnpm --filter @repo/api reseal, then remove the previous key.
ENCRYPTION_KEY=
# ENCRYPTION_KEY_PREVIOUS=

# Who may create an account once the instance is claimed: invite (nobody
# without an invitation), domain (addresses at SIGNUP_ALLOWED_DOMAINS, a
# comma-separated list) or open (anyone).
SIGNUP_MODE=invite
# SIGNUP_ALLOWED_DOMAINS=

# noop = nothing is sent; each send is logged by subject and recipient (and,
# in development only, its link). smtp = delivered through SMTP_URL, an
# smtp:// or smtps:// URL with credentials, from EMAIL_FROM.
EMAIL_PROVIDER=noop
# SMTP_URL=
# EMAIL_FROM=

# The most a scene may hold; a save past either is refused whole.
# SCENE_MAX_ELEMENTS=20000
# SCENE_MAX_MB=10

# Where images in scenes are kept, sealed with ENCRYPTION_KEY. memory = in the
# API's memory, lost on restart, refused in production. s3 = any S3-compatible
# bucket; for a local gateway, uncomment these.
STORAGE_PROVIDER=memory
# STORAGE_PROVIDER=s3
# S3_ENDPOINT=http://localhost:7098
# S3_REGION=us-east-1
# S3_BUCKET=excalidraw-plus
# S3_ACCESS_KEY_ID=local
# S3_SECRET_ACCESS_KEY=local-development-only
# S3_FORCE_PATH_STYLE=true

# The largest image a scene accepts, in MB.
# FILE_MAX_MB=4

# Whether people may add libraries from the public library site,
# libraries.excalidraw.com, to their personal library. false hides the editor's
# browse button and keeps the content security policy to this origin alone.
# LIBRARY_BROWSING=true

# Which sites may embed a scene's view link in an iframe: * for any, or a
# comma-separated list of origins such as https://wiki.example.com. Every other
# page refuses to be framed.
# EMBED_ALLOWED_ORIGINS=*

# Sign-in providers: each is offered once both its variables are set. Callback
# URLs to register are <PUBLIC_BASE_URL>/auth/callback/<google|github|microsoft|oidc>.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_BUTTON_LABEL=Single sign-on

# Where the client's address comes from, for rate limiting sign-in. Behind a
# proxy that appends to X-Forwarded-For, list the proxies' addresses or CIDR
# ranges in TRUSTED_PROXIES. With no proxy in front of the server at all, set
# CLIENT_IP_HEADER=none to use the connection's own address. On Railway, set
# CLIENT_IP_HEADER=x-real-ip: its edge overwrites that header with the visitor's
# address, while X-Forwarded-For arrives as a chain.
# CLIENT_IP_HEADER=x-forwarded-for
# TRUSTED_PROXIES=

# Days the audit log keeps an event before the daily prune removes it.
# AUDIT_RETENTION_DAYS=365

# Requests each API key may make a minute on the REST API.
# API_RATE_LIMIT_PER_MINUTE=120

# Voice and screen sharing, off unless all three are set: a LiveKit Cloud project
# or a LiveKit server with public UDP.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# AI text-to-diagram, off unless a provider is set. AI_PROVIDER is anthropic,
# openai or openai-compatible (any server that speaks OpenAI's chat API, such as a
# self-hosted model); AI_MODEL names the provider's model. anthropic and openai
# need AI_API_KEY; openai-compatible needs AI_BASE_URL, and AI_API_KEY if the
# server asks for one. AI_VISION_MODEL names a model of the same provider that
# reads images, and turns on wireframe to code.
# AI_PROVIDER=anthropic
# AI_API_KEY=
# AI_MODEL=
# AI_VISION_MODEL=
# AI_BASE_URL=
# Requests each person may make a day on this provider (default 100); 0 means no
# limit, and an empty value refuses to start. A
# workspace that connects its own key in Settings → AI is not counted.
# AI_DAILY_LIMIT=100
